---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/chai-trek-wide.jpg';
---

<BaseLayout title="About | Chaitanya's blog" description="About Chaitanya, bio, research interests, and writings." fullBleed={true}>
  <div class="about-split">
    <!-- Left Half: Full Portrait / Picture -->
    <div class="about-split-left">
      <Image
        src={portrait}
        alt="Chaitanya"
        width={1200}
        loading="eager"
      />
    </div>

    <!-- Right Half: Bio Text -->
    <div class="about-split-right">
      <h2>Chaitanya Sanivada</h2>
      <!--
      <div class="subtitle">Writer, builder, and researcher.</div>
      -->

      <p>
        Hi! Welcome to my blog. I like learning new things, I'm currently interested in using software & AI to solve problems around me.
      </p>

      <p>
        I document my technical notes, opinions, and personal experiences here.
      </p>

      <p>
        <b><a href="https://x.com/snvdch" target="_blank" rel="noopener noreferrer">Twitter</a></b>
      </p>
    </div>
  </div>
</BaseLayout>
